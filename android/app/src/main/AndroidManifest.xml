<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The rider's location, for the site's 'near me': asked for once, by the browser through DelegationService. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <application
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:allowBackup="false"
    android:supportsRtl="true"
    android:theme="@style/Theme.CacheRider">

    <!-- The site vouches for this app in /.well-known/assetlinks.json; the browser checks it and drops its toolbar. -->
    <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

    <activity
      android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
      android:exported="true"
      android:label="@string/app_name"
      android:theme="@style/Theme.CacheRider.Launcher">
      <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="https://cacherider.com/" />
      <!-- The bars, read from this activity (not the application, where they were ignored): the phone's light or
           dark, as the site follows it by default. The page's theme colour takes the status bar once it loads;
           the navigation bar stays as set here, since a page can't change it. -->
      <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/bars_light" />
      <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK" android:resource="@color/bars" />
      <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/bars_light" />
      <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK" android:resource="@color/bars" />
      <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_DIVIDER_COLOR" android:resource="@color/bars_light" />
      <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_DIVIDER_COLOR_DARK" android:resource="@color/bars" />
      <!-- The splash is Android's own start screen again (the launcher icon in its 160 dp circle, 240 dp across), so
           the hand-over from the system's to this one, shown until the page draws, can't be seen: from drawable-xxxhdpi,
           so a phone scales it down to that size (from drawable/ it was taken for a low-density image and blown up
           three times, cropped off the screen), and shown unscaled, centred. -->
      <meta-data android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE" android:resource="@drawable/splash" />
      <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR" android:resource="@color/splash" />
      <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION" android:value="200" />
      <meta-data android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY" android:value="com.cacherider.android.fileprovider" />
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Links to cacherider.com open in the app once the asset link verifies. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" android:host="cacherider.com" />
      </intent-filter>
    </activity>

    <!-- The browser's requests for location, answered with this app's permission (and Android's prompt for it). -->
    <service android:name=".DelegationService" android:enabled="true" android:exported="true">
      <intent-filter>
        <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </service>
    <activity
      android:name="com.google.androidbrowserhelper.locationdelegation.PermissionRequestActivity"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:exported="false" />

    <!-- Hands the splash image to the browser. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="com.cacherider.android.fileprovider"
      android:grantUriPermissions="true"
      android:exported="false">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/filepaths" />
    </provider>
  </application>
</manifest>
