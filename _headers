# Cloudflare Pages
/tiles/*
  Cache-Control: public, max-age=604800
/tiles/*.pbf
  Content-Type: application/x-protobuf
/data/*.json
  Cache-Control: public, max-age=600
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=604800
/sw.js
  Cache-Control: no-cache
