#!/bin/sh
# Before every push to GitHub (every push redeploys the site): the smoke test, every flow in a real browser at a
# phone's size and a desktop's (tools/smoke). A failure stops the push. Installed by
#   git config core.hooksPath tools/hooks
# A push that must go regardless: git push --no-verify.
cd "$(git rev-parse --show-toplevel)/tools/smoke" || exit 1
[ -d node_modules ] || npm ci --silent || exit 1
npx --no-install playwright install chromium >/dev/null 2>&1
echo "Smoke test before the push…"
if ! npx --no-install playwright test --reporter=dot; then
  echo
  echo "Smoke test failed: the push is stopped. See above; tools/smoke/test-results has a trace of each failure."
  exit 1
fi
