#!/bin/sh
# Before a push to GitHub (every push redeploys the site): the smoke test, every flow in a real browser at a phone's
# size and a desktop's (tools/smoke), when the commits going up touch what a rider gets (the app, its styles, its
# data, the page, the worker file, the vendored libraries). A push of the relay, the tools or the notes goes straight
# through: three minutes of browsers would confirm nothing about it. A failure stops the push. This is the one place
# the test runs: on this machine, never on GitHub. Installed by
#   git config core.hooksPath tools/hooks
# Run it by hand any time: cd tools/smoke && npm test. A push that must go regardless: git push --no-verify.
# One run at a time: every worktree's run serves the app on port 8795, and when sessions in several worktrees pushed at
# once, each run's start killed the server of the one before it, failing that push. A run waits for its turn
# (tools/smoke/wait-turn.sh, a lock in the repository's shared .git), saying whose run it's waiting on. A run by hand
# takes the same turn, so it neither kills nor is killed by a push's:
#   cd tools/smoke && sh wait-turn.sh npx playwright test -g 'search'      (npm test takes it too)
hooks="$(cd "$(dirname "$0")" && pwd)"   # wait-turn.sh beside this hook: a worktree branched before it existed waits too
root="$(git rev-parse --show-toplevel)"
touched=0; lines=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  lines=$((lines + 1))
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac   # a branch deleted: nothing to test
  case "$remote_sha" in 0000000000000000000000000000000000000000) range="$local_sha" ;; *) range="$remote_sha..$local_sha" ;; esac
  hits="$(git -C "$root" diff --name-only $range 2>/dev/null | grep -E '^(app/|css/|data/|vendor/|tiles/|index\.html$|sw\.js$|manifest\.webmanifest$)' | head -5 | tr '\n' ' ')"
  [ -n "$hits" ] && { touched=1; echo "Smoke test: this push touches $hits"; }
  # The worker's VERSION is what tells an installed app there's a new one: a push changing the app's own files without
  # it reached no installed phone (Aaron: "never actually bumped the version in sw.js", cr-v534 to 542 went up at
  # cr-v533's). And every module of the app in its list (SHELL), or offline it can't load (holiday.js wasn't).
  if [ "$remote_sha" != 0000000000000000000000000000000000000000 ]; then
    app="$(git -C "$root" diff --name-only $range 2>/dev/null | grep -E '^(app/|css/|index\.html$|manifest\.webmanifest$)' | head -3 | tr '\n' ' ')"
    if [ -n "$app" ] && ! git -C "$root" diff $range -- sw.js | grep -q "^+const VERSION"; then
      echo "Push stopped: it changes $app but not VERSION in sw.js, so installed apps would never update. Bump it (the commit's cr-v number)."; exit 1
    fi
  fi
  shell="$(git -C "$root" show "$local_sha:sw.js" 2>/dev/null)"
  for f in $(git -C "$root" ls-tree -r --name-only "$local_sha" app | grep '\.js$'); do
    case "$shell" in *"'./$f'"*) ;; *) echo "Push stopped: $f isn't in sw.js SHELL, so the installed app can't load it offline. Add it."; exit 1 ;; esac
  done
done
# No ref lines at all (a push once went up untested with the app changed, the hook having read nothing): tested, not waved through.
[ "$lines" = 0 ] && { touched=1; echo "Smoke test: no refs read from git; testing the lot."; }
if [ "$touched" = 0 ]; then echo "Smoke test skipped: nothing a rider gets is in this push."; exit 0; fi
cd "$root/tools/smoke" || exit 1
[ -d node_modules ] || npm ci --silent || exit 1
npx --no-install playwright install chromium >/dev/null 2>&1
echo "Smoke test before the push…"
# With the turn, a server left on the port by a run cut short is stopped; one serving a run still going, waited for.
# Kept awake while it runs (caffeinate -i, where there is one): a Mac left idle slept mid-run, its browsers frozen and
# their tests timed out, the run 15 minutes longer. A lid closed on battery still sleeps it: push with the lid open.
awake=; command -v caffeinate >/dev/null 2>&1 && awake='caffeinate -i'
if ! $awake sh "$hooks/../smoke/wait-turn.sh" npx --no-install playwright test --reporter=dot; then
  echo
  echo "Smoke test failed: the push is stopped. See above; tools/smoke/test-results has a trace of each failure."
  exit 1
fi
