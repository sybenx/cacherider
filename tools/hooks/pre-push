#!/bin/sh
# Before a push to GitHub (every push redeploys the site): the smoke test, every flow in a real browser at a phone's
# size and a desktop's (tools/smoke), when the commits going up touch what a rider gets (the app, its styles, its
# data, the page, the worker file, the vendored libraries). A push of the relay, the tools or the notes goes straight
# through: three minutes of browsers would confirm nothing about it. A failure stops the push. This is the one place
# the test runs: on this machine, never on GitHub. Installed by
#   git config core.hooksPath tools/hooks
# Run it by hand any time: cd tools/smoke && npm test. A push that must go regardless: git push --no-verify.
root="$(git rev-parse --show-toplevel)"
touched=0; lines=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  lines=$((lines + 1))
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac   # a branch deleted: nothing to test
  case "$remote_sha" in 0000000000000000000000000000000000000000) range="$local_sha" ;; *) range="$remote_sha..$local_sha" ;; esac
  hits="$(git -C "$root" diff --name-only $range 2>/dev/null | grep -E '^(app/|css/|data/|vendor/|tiles/|index\.html$|sw\.js$|manifest\.webmanifest$)' | head -5 | tr '\n' ' ')"
  [ -n "$hits" ] && { touched=1; echo "Smoke test: this push touches $hits"; }
done
# No ref lines at all (a push once went up untested with the app changed, the hook having read nothing): tested, not waved through.
[ "$lines" = 0 ] && { touched=1; echo "Smoke test: no refs read from git; testing the lot."; }
if [ "$touched" = 0 ]; then echo "Smoke test skipped: nothing a rider gets is in this push."; exit 0; fi
cd "$root/tools/smoke" || exit 1
[ -d node_modules ] || npm ci --silent || exit 1
# A test server left behind by a run that was cut short (its port, 8795, still held) stopped the next run before it
# began: 'Process from config.webServer was not able to start'. Freed first.
for p in $(lsof -ti tcp:8795 2>/dev/null); do kill "$p" 2>/dev/null; done
npx --no-install playwright install chromium >/dev/null 2>&1
echo "Smoke test before the push…"
if ! npx --no-install playwright test --reporter=dot; then
  echo
  echo "Smoke test failed: the push is stopped. See above; tools/smoke/test-results has a trace of each failure."
  exit 1
fi
